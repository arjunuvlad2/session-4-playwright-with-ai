{
  "name": "qa-project",
  "version": "1.0.0",
  "private": true,
  "description": "Automation Testing Using AI \u2014 course project (Sessions 2-5: UI + API + self-healing/MCP)",
  "scripts": {
    "test": "playwright test --grep-invert \"@lab\"",
    "test:s2": "playwright test tests/session2",
    "test:s3": "playwright test tests/session3",
    "test:s4": "playwright test tests/session4",
    "test:s5": "playwright test tests/session5/resilient-locators.spec.ts",
    "lab:heal": "playwright test tests/session5/heal-me.spec.ts",
    "lab:visual": "playwright test tests/session5/visual-validation.spec.ts",
    "test:api": "playwright test tests/session4",
    "headed": "playwright test --headed",
    "watch": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.saucedemo.com"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0"
  }
}
